{
  "image": "dockd/claude-code:latest",
  "shell": "claude",
  "build": { "dockerfile": "claude_code.Dockerfile" },
  "env": [
    {"name": "ANTHROPIC_API_KEY", "optional": true},
    {"name": "CLAUDE_CODE_OAUTH_TOKEN", "optional": true},
    {"name": "CLAUDE_CODE_USE_BEDROCK", "optional": true},
    {"name": "AWS_ACCESS_KEY_ID", "optional": true},
    {"name": "AWS_SECRET_ACCESS_KEY", "optional": true},
    {"name": "AWS_SESSION_TOKEN", "optional": true},
    {"name": "AWS_REGION", "optional": true},
    {"name": "CLAUDE_CODE_USE_VERTEX", "optional": true},
    {"name": "ANTHROPIC_VERTEX_PROJECT_ID", "optional": true},
    {"name": "CLOUD_ML_REGION", "optional": true},
    {"name": "GOOGLE_APPLICATION_CREDENTIALS", "optional": true},
    {"name": "GITHUB_TOKEN", "optional": true}
  ],
  "mounts": [
    "${HOME}/dockd-output:/workspace/output"
  ],
  "repos": [
    {
      "url": "${DOCKD_REPO_URL}",
      "ref": "${DOCKD_REPO_REF:-main}",
      "dest": "/workspace/repo"
    }
  ],
  "steps": [
    {
      "label": "scaffold output dir",
      "cmd": ["mkdir", "-p", "/workspace/output"]
    }
  ]
}
