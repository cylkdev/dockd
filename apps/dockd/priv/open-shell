#!/bin/sh
# open-shell — open a new terminal window running the given command.
#
# Invoked by `dockd instance shell` (see
# apps/dockd_cli/lib/dockd_cli/commands/instance/shell.ex). The full command to
# run — e.g. `docker exec -it dockd-web /bin/sh` — is passed as a single
# argument. A brand-new terminal window owns its own TTY, so the compiled binary
# never has to hand over its controlling terminal.
set -eu

cmd=${1:?open-shell: no command given}

# $TERMINAL override (any OS). Must accept: "$TERMINAL" -e sh -c "<cmd>".
if [ -n "${TERMINAL:-}" ]; then
  exec "$TERMINAL" -e sh -c "$cmd"
fi

case "$(uname -s)" in
  Darwin)
    # Escape for an AppleScript double-quoted string literal.
    esc=$(printf '%s' "$cmd" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
    osascript -e "tell application \"Terminal\" to do script \"$esc\"" \
              -e 'tell application "Terminal" to activate'
    ;;
  Linux)
    for t in x-terminal-emulator gnome-terminal konsole xterm; do
      if command -v "$t" >/dev/null 2>&1; then
        case $t in
          gnome-terminal) exec "$t" -- sh -c "$cmd" ;;
          *) exec "$t" -e sh -c "$cmd" ;;
        esac
      fi
    done
    printf '%s\n' "open-shell: no terminal found; set \$TERMINAL to your emulator" >&2
    exit 1
    ;;
  *)
    printf '%s\n' "open-shell: unsupported OS $(uname -s)" >&2
    exit 1
    ;;
esac
